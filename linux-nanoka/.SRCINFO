pkgname = linux-nanoka
	pkgdesc = The Linux EEVDF + LTO + AutoFDO + Propeller Cachy Sauce Kernel by CachyOS with other patches and improvements. Build by Nanoka with love. kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE
	provides = linux-cachyos-lto=7.3.0-4
	replaces = linux-cachyos-lto

pkgname = linux-nanoka-headers
	pkgdesc = Headers and scripts for building modules for the Linux EEVDF + LTO + AutoFDO + Propeller Cachy Sauce Kernel by CachyOS with other patches and improvements. Build by Nanoka with love. kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-nanoka
	depends = clang
	depends = llvm
	depends = lld
	provides = LINUX-HEADERS
	provides = linux-cachyos-lto-headers=7.3.0-4
	replaces = linux-cachyos-lto-headers

pkgname = linux-nanoka-zfs
	pkgdesc = zfs module for the Linux EEVDF + LTO + AutoFDO + Propeller Cachy Sauce Kernel by CachyOS with other patches and improvements. Build by Nanoka with love. kernel
	license = CDDL
	depends = pahole
	depends = linux-nanoka=7.3.0-4
	provides = ZFS-MODULE

pkgname = linux-nanoka-nvidia-open
	pkgdesc = nvidia open modules of 615.78.08 driver for the linux-nanoka kernel
	license = MIT AND GPL-2.0-only
	depends = linux-nanoka=7.3.0-4
	depends = nvidia-utils=615.78.08
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-nanoka-nvidia

pkgname = linux-nanoka-r8125
	pkgdesc = r8125 modules for the linux-nanoka kernel
	license = GPL-2.0-only
	depends = linux-nanoka=7.3.0-4
